// Magicmida - C++ port
// Embed the application manifest.

1 24 "@MAGICMIDA_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@MAGICMIDA_FILE_DESCRIPTION@"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "@MAGICMIDA_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@MAGICMIDA_ORIGINAL_FILENAME@"
            VALUE "ProductName", "Magicmida"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
